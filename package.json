{
  "name": "agent-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "npx prettier --write \"src/**/*.{ts,tsx,js,json}\"",
    "test:unit": "vitest run",
    "test:bench": "vitest bench --run",
    "test:e2e": "npx bddgen && playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.209",
    "@prisma/client": "5.22.0",
    "@privy-io/react-auth": "^1.74.1",
    "@privy-io/server-auth": "^1.17.2",
    "@stripe/stripe-js": "^9.8.0",
    "ai": "^6.0.200",
    "lucide-react": "1.20.0",
    "next": "^9.3.3",
    "pg": "^8.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "22.2.1",
    "viem": "^0.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "4.1.9",
    "eslint": "10.5.0",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "playwright-bdd": "^9.0.0",
    "prisma": "5.22.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
