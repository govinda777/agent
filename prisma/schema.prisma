generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventStore {
  id            String   @id @default(uuid())
  tenantId      String
  aggregateType String   // AGENT, TENANT, EXECUTION
  aggregateId   String
  eventType     String   // AgentCreated, AgentExecutionStarted, etc.
  payload       Json
  externalEventId String?
  createdAt     DateTime @default(now())

  @@unique([tenantId, externalEventId])

  @@index([tenantId])
  @@index([aggregateId])
  @@index([aggregateType, aggregateId])
}

model Tenant {
  id              String    @id @default(uuid())
  status          String    @default("FREE") // FREE, ACTIVE, SUSPENDED, OVER_BUDGET
  trialEndsAt     DateTime
  executionsUsed  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agents          Agent[]
  users           TenantUser[]
}

model User {
  id        String   @id @default(uuid())
  privyId   String   @unique
  email     String?
  llmProvider String?
  llmApiKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants   TenantUser[]
}

model TenantUser {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      String   @default("OWNER") // OWNER, ADMIN, MEMBER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
}

model Agent {
  id              String    @id @default(uuid())
  name            String
  n8nWebhookUrl   String
  n8nAuthToken    String
  
  // Canais ativos
  channelWeb      Boolean   @default(false)
  channelWhatsapp Boolean   @default(false)
  channelInstagram Boolean  @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
}

// Projeção de Execuções para leitura rápida
model ExecutionProjection {
  id              String    @id
  tenantId        String
  agentId         String
  status          String    // PENDING, RUNNING, COMPLETED, FAILED
  currentStep     String?
  result          Json?
  startedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([agentId])
}
